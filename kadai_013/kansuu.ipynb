   "source": [
    "# 消費税込みの金額を計算する関数\n",
    "def calc_tax(price, tax):\n",
    "    total = price + (price * tax / 100)\n",
    "    return total\n",
    "\n",
    "# 第1引数：商品の金額「110」\n",
    "# 第2引数：消費税率「8%」\n",
    "result = calc_tax(110, 8)\n",
    "\n",
    "# 計算結果を表示する\n",
    "print(result)"
   ]
  }
 ],
